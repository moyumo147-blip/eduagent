# ============================================================
# EduAgent .gitignore
# 目的：排除真实密钥、个人信息、本地模型权重与构建/环境产物，
#       仅让源代码与资源文件进入版本库。
# ============================================================

# ---------- 环境变量（含真实 API 密钥 / JWT 密钥 / 数据库密码）----------
.env
.env.local
.env.*.local
frontend/.env.local
frontend/.env
frontend/.env.*.local

# ---------- 个人数据 / 敏感文件 ----------
# 简历评估数据含真实个人信息（姓名/手机/邮箱），请替换为脱敏示例后再提交
backend/agents/resume/resume.json
backend/agents/resume/*.pdf
# 本地数据库文件（可能含用户/测试数据）
*.db
*.sqlite
*.sqlite3

# ---------- 硬编码了数据库凭据的检查脚本 ----------
# 该脚本内联了数据库账号密码（123456），改为从环境变量读取后再解除忽略
check_env.py

# ---------- 本地模型权重（体积大，应通过下载/重建获得）----------
backend/models/

# ---------- Python ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- 前端依赖与构建产物 ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---------- IDE / 系统 / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- 日志与运行时 ----------
*.log
logs/
*.pid